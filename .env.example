# AI/ML
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."
PINECONE_API_KEY="..."
PINECONE_ENVIRONMENT="us-west1-gcp"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments - Crypto
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
