PAYMENT_WALLET_SOLANA="YOUR_SOLANA_WALLET_ADDRESS"
PAYMENT_WALLET_ETHEREUM="YOUR_ETH_WALLET_ADDRESS"

# Payments - IAP
REVENUECAT_API_KEY="..."
APPLE_APP_STORE_SHARED_SECRET="..."
